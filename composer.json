{
    "name": "lindemannrock/craft-campaign-manager",
    "description": "Campaign management for Craft CMS surveys with SMS and email invitations, recipient tracking, and analytics.",
    "type": "craft-plugin",
    "version": "5.11.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "campaigns",
        "surveys",
        "sms",
        "email",
        "invitations",
        "analytics"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Bilal Hary Lindemann",
            "email": "bh@lindemannrock.com",
            "homepage": "https://lindemannrock.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@lindemannrock.com",
        "issues": "https://github.com/LindemannRock/craft-campaign-manager/issues",
        "source": "https://github.com/LindemannRock/craft-campaign-manager",
        "docs": "https://github.com/LindemannRock/craft-campaign-manager/blob/main/README.md"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "lindemannrock/craft-plugin-base": "^5.0",
        "lindemannrock/craft-logging-library": "^5.0",
        "lindemannrock/craft-sms-manager": "^5.0",
        "verbb/formie": "^3.0",
        "giggsey/libphonenumber-for-php": "^8.13"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^11.0",
        "lindemannrock/craft-formie-rating-field": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "lindemannrock\\campaignmanager\\": "src/",
            "lindemannrock\\campaignmanager\\tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan --ansi --memory-limit=1G",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi",
        "test": "phpunit --colors=always",
        "install-hooks": "git config core.hooksPath .githooks 2>/dev/null || true",
        "post-install-cmd": "@install-hooks",
        "post-update-cmd": "@install-hooks"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "name": "Campaign Manager",
        "handle": "campaign-manager",
        "developer": "LindemannRock",
        "developerUrl": "https://lindemannrock.com",
        "documentationUrl": "https://github.com/LindemannRock/craft-campaign-manager/blob/main/README.md",
        "changelogUrl": "https://github.com/LindemannRock/craft-campaign-manager/blob/main/CHANGELOG.md",
        "class": "lindemannrock\\campaignmanager\\CampaignManager"
    }
}
