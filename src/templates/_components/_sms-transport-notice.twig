{% set hold = craft.app.plugins.getPlugin('campaign-manager').sms.getTransportHoldNotice(campaign.senderHandle) %}
{% if hold %}
    {% set message %}
        <p>{{ 'SMS sending is paused. Pending SMS recipients remain pending. Email continues independently.'|t('campaign-manager') }}
        {% if hold.manual %}
            {% set smsManagerLink = hold.statusUrl
                ? '<a href="' ~ hold.statusUrl|e ~ '">SMS Manager</a>'
                : 'SMS Manager' %}
            {{ 'Resolve the issue and release any hold in SMS Manager, then use Run Campaign to send pending invitations.'|t('campaign-manager')|e|replace({'SMS Manager': smsManagerLink})|raw }}
        {% endif %}
        {% if hold.recoveryAt %}
            {{ 'Timed transport recovery: {time}. Queued SMS continuations can run after this time if no other hold applies.'|t('campaign-manager', {time: hold.recoveryAt|lrDatetime}) }}
        {% endif %}
        {% if hold.statusUrl and not hold.manual %}
            <a href="{{ hold.statusUrl }}">{{ 'View Transport Status'|t('campaign-manager') }}</a>
        {% endif %}
        </p>
    {% endset %}
    {% if tableNotice ?? false %}
        <div class="lr-info-box-table-wrapper">
    {% endif %}
    {% include 'lindemannrock-base/_components/info-box' with {
        message: message,
        type: 'warning',
        variant: 'colored',
        margin: (tableNotice ?? false) ? 'none' : 'bottom',
        stretch: tableNotice ?? false,
        boxId: 'campaign-sms-transport-notice',
    } only %}
    {% if tableNotice ?? false %}
        </div>
    {% endif %}
{% endif %}
