{% extends 'campaign-manager/_layouts/settings' %}
{% import '_includes/forms.twig' as forms %}

{% set title = 'General Settings'|t('campaign-manager') %}
{% set selectedSettingsItem = 'general' %}
{% set settingsCrumb = 'General'|t('campaign-manager') %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('campaign-manager/settings/save') }}
    {{ redirectInput('campaign-manager/settings') }}
    {{ hiddenInput('section', 'general') }}

    <h2 class="first">{{ "General Settings"|t('campaign-manager') }}</h2>

    {% include 'lindemannrock-base/_partials/field-plugin-name' with {
        settings: settings,
        pluginHandle: 'campaign-manager',
    } only %}

    <hr>

    <h2>{{ "SMS Settings"|t('campaign-manager') }}</h2>

    {% if craft.campaignManager.sms.isSmsManagerAvailable() %}
        {# Single Sender ID dropdown with `<optgroup>` provider groupings.
           The provider is implicit in the sender's `providerHandle` —
           there's no separate provider setting at the plugin level. The
           country-filter logic on recipients pages derives the provider
           from the saved sender (or the SMS Manager default sender for
           the "Use Default" sentinel) at render time. #}
        {% set senderIdOptions = craft.campaignManager.sms.getSenderIdOptionsWithGroups() %}

        {# Build sender→provider + per-provider country/name lookup so the JS
           below can update the country preview when the dropdown changes. #}
        {% set senderToProvider = {} %}
        {% set countriesByProvider = {} %}
        {% set providerNames = {} %}
        {% set countryNames = {} %}
        {% for provider in craft.campaignManager.sms.getAvailableProviders() %}
            {% set countries = craft.campaignManager.sms.getAllowedCountries(provider.handle) %}
            {% set countriesByProvider = countriesByProvider|merge({(provider.handle): countries}) %}
            {% set providerNames = providerNames|merge({(provider.handle): provider.name}) %}
            {% for code in countries %}
                {% if code != '*' and countryNames[code] is not defined %}
                    {% set countryNames = countryNames|merge({(code): lrCountryName(code)}) %}
                {% endif %}
            {% endfor %}
            {% for sender in craft.campaignManager.sms.getAvailableSenderIds(provider.handle) %}
                {% set senderToProvider = senderToProvider|merge({(sender.handle): provider.handle}) %}
            {% endfor %}
        {% endfor %}

        {# Provider handle the "Use SMS Manager default" sentinel currently
           resolves to (null when sms-manager has no default configured).
           Used for the country preview when admin's choice is the sentinel. #}
        {% set defaultSenderProviderHandle = craft.campaignManager.sms.getResolvedDefaultSenderProvider() %}

        {{ forms.selectField({
            label: 'Default Sender ID'|t('campaign-manager'),
            instructions: 'Senders are grouped by their provider. Pick "Use SMS Manager default" to follow whatever is configured plugin-wide; pick a specific sender to pin this default to that sender regardless of future SMS Manager changes.'|t('campaign-manager'),
            id: 'defaultSenderIdHandle',
            name: 'settings[defaultSenderIdHandle]',
            value: settings.defaultSenderIdHandle,
            options: senderIdOptions,
            errors: settings.getErrors('defaultSenderIdHandle'),
            disabled: settings.isOverriddenByConfig('defaultSenderIdHandle'),
            warning: settings.isOverriddenByConfig('defaultSenderIdHandle') ?
                "This is being overridden by the <code>defaultSenderIdHandle</code> setting in <code>config/campaign-manager.php</code>."|t('campaign-manager')|raw : null,
        }) }}

        {# Country preview — resolve the effective provider from the saved
           sender choice. Use Default (`''`) resolves via SMS Manager's
           default sender; specific handles resolve via the senderToProvider
           map; null means no sender has been picked yet. #}
        {% set savedHandle = settings.defaultSenderIdHandle %}
        {% if savedHandle is same as('') %}
            {% set previewProviderHandle = defaultSenderProviderHandle %}
        {% elseif savedHandle %}
            {% set previewProviderHandle = senderToProvider[savedHandle] ?? null %}
        {% else %}
            {% set previewProviderHandle = null %}
        {% endif %}

        {% set previewProvider = null %}
        {% if previewProviderHandle %}
            {% for provider in craft.campaignManager.sms.getAvailableProviders() %}
                {% if provider.handle == previewProviderHandle %}
                    {% set previewProvider = provider %}
                {% endif %}
            {% endfor %}
        {% endif %}
        {% set previewCountries = previewProviderHandle ? (countriesByProvider[previewProviderHandle] ?? []) : [] %}
        {% set formattedCountries = [] %}
        {% for code in previewCountries %}
            {% if code != '*' %}
                {% set formattedCountries = formattedCountries|merge([lrCountryWithDialCode(code)]) %}
            {% endif %}
        {% endfor %}
        {% set countryMessage = previewCountries == ['*']
            ? 'Allowed countries for <strong>' ~ (previewProvider.name ?? '') ~ '</strong>: All countries.'
            : 'Allowed countries for <strong>' ~ (previewProvider.name ?? '') ~ '</strong>: ' ~ formattedCountries|join(', ') ~ '.' %}
        {% include 'lindemannrock-base/_components/info-box' with {
            message: countryMessage,
            type: 'info',
            margin: 'top',
            boxId: 'provider-countries-box',
            messageId: 'provider-countries-message',
            hidden: not previewProviderHandle,
        } %}

        {% js %}
            (function() {
                var senderToProvider = {{ senderToProvider|json_encode|raw }};
                var countriesByProvider = {{ countriesByProvider|json_encode|raw }};
                var providerNames = {{ providerNames|json_encode|raw }};
                var countryNames = {{ countryNames|json_encode|raw }};
                var defaultSenderProviderHandle = {{ (defaultSenderProviderHandle ?? '')|json_encode|raw }};
                var senderIdSelect = document.getElementById('defaultSenderIdHandle');
                var countriesBox = document.getElementById('provider-countries-box');
                var countriesMessage = document.getElementById('provider-countries-message');

                function formatCountry(code) {
                    var name = countryNames[code] || code;
                    return name + ' (' + code + ')';
                }

                function resolveProviderForSender(senderHandle) {
                    if (senderHandle === '') {
                        // "Use SMS Manager default" sentinel — provider comes
                        // from sms-manager's currently-configured default.
                        return defaultSenderProviderHandle;
                    }
                    return senderToProvider[senderHandle] || '';
                }

                function updateCountries() {
                    if (!countriesBox || !countriesMessage) {
                        return;
                    }
                    var providerHandle = resolveProviderForSender(senderIdSelect.value);
                    if (!providerHandle) {
                        countriesBox.style.display = 'none';
                        return;
                    }
                    var countries = countriesByProvider[providerHandle] || [];
                    var providerName = providerNames[providerHandle] || providerHandle;
                    var message;
                    if (countries.length === 1 && countries[0] === '*') {
                        message = {{ 'Allowed countries for'|t('campaign-manager')|json_encode|raw }} + ' <strong>' + providerName + '</strong>: ' + {{ 'All countries.'|t('campaign-manager')|json_encode|raw }};
                    } else if (countries.length > 0) {
                        var formatted = countries.map(formatCountry).join(', ');
                        message = {{ 'Allowed countries for'|t('campaign-manager')|json_encode|raw }} + ' <strong>' + providerName + '</strong>: ' + formatted + '.';
                    } else {
                        message = {{ 'No country restrictions for'|t('campaign-manager')|json_encode|raw }} + ' <strong>' + providerName + '</strong>.';
                    }
                    countriesMessage.innerHTML = message;
                    countriesBox.style.display = '';
                }

                senderIdSelect.addEventListener('change', updateCountries);
            })();
        {% endjs %}
    {% else %}
        {% include 'lindemannrock-base/_components/info-box' with {
            type: 'notice',
            message: 'SMS Manager plugin is not installed or enabled. <a href="' ~ cpUrl('settings/plugins') ~ '">Enable SMS Manager</a> to configure SMS settings.'|t('campaign-manager')
        } %}
    {% endif %}

    <hr>

    <h2>{{ "Invitation Settings"|t('campaign-manager') }}</h2>

    {{ forms.textField({
        label: 'Invitation Route'|t('campaign-manager'),
        instructions: 'The URL path for invitation pages (without leading slash).'|t('campaign-manager'),
        id: 'invitationRoute',
        name: 'settings[invitationRoute]',
        value: settings.invitationRoute,
        placeholder: 'cm/invite',
        required: true,
        errors: settings.getErrors('invitationRoute'),
        disabled: settings.isOverriddenByConfig('invitationRoute'),
        warning: settings.isOverriddenByConfig('invitationRoute') ?
            "This is being overridden by the <code>invitationRoute</code> setting in <code>config/campaign-manager.php</code>."|t('campaign-manager')|raw : null,
    }) }}

    {{ forms.textField({
        label: 'Invitation Template'|t('campaign-manager'),
        instructions: 'Path to your Invitation template in your templates/ folder (e.g., campaign-manager/invite).'|t('campaign-manager'),
        id: 'invitationTemplate',
        name: 'settings[invitationTemplate]',
        value: settings.invitationTemplate,
        placeholder: 'campaign-manager/invite',
        errors: settings.getErrors('invitationTemplate'),
        tip: "Copy reference template from <code>vendor/lindemannrock/craft-campaign-manager/src/templates/invite.twig</code> to your project's templates folder."|t('campaign-manager')|raw,
        disabled: settings.isOverriddenByConfig('invitationTemplate'),
        warning: settings.isOverriddenByConfig('invitationTemplate') ?
            "This is being overridden by the <code>invitationTemplate</code> setting in <code>config/campaign-manager.php</code>."|t('campaign-manager')|raw : null,
    }) }}

    <hr>

    <h2>{{ "Logging Settings"|t('campaign-manager') }}</h2>

    {% include 'lindemannrock-base/_partials/field-log-level' with {
        settings: settings,
        pluginHandle: 'campaign-manager',
    } only %}

    <hr>

    <h2>{{ "Activity Logs"|t('campaign-manager') }}</h2>

    {{ forms.lightswitchField({
        label: "Enable Activity Logs"|t('campaign-manager'),
        instructions: "Store activity records for auditing and debugging (recipients, imports, campaign runs)."|t('campaign-manager'),
        id: 'enableActivityLogs',
        name: 'settings[enableActivityLogs]',
        on: settings.enableActivityLogs ?? true,
        toggle: 'activity-logs-settings',
        errors: settings.getErrors('enableActivityLogs'),
        disabled: settings.isOverriddenByConfig('enableActivityLogs'),
        warning: settings.isOverriddenByConfig('enableActivityLogs') ?
            "This is being overridden by the <code>enableActivityLogs</code> setting in <code>config/campaign-manager.php</code>."|t('campaign-manager')|raw : null,
    }) }}

    <div id="activity-logs-settings" class="{{ not (settings.enableActivityLogs ?? true) ? 'hidden' }}">
        <div class="field">
            <p class="light">
                {{ "Activity logs are stored in the database. IP, device, and user agent capture will be centralized in Base in a future update."|t('campaign-manager') }}
            </p>
        </div>

        {{ forms.textField({
            label: 'Logs Retention (Days)'|t('campaign-manager'),
            instructions: 'Number of days to retain activity logs (0 = keep forever)'|t('campaign-manager'),
            id: 'activityLogsRetention',
            name: 'settings[activityLogsRetention]',
            type: 'number',
            value: settings.activityLogsRetention,
            required: true,
            errors: settings.getErrors('activityLogsRetention'),
            disabled: settings.isOverriddenByConfig('activityLogsRetention'),
            warning: settings.isOverriddenByConfig('activityLogsRetention') ?
                "This is being overridden by the <code>activityLogsRetention</code> setting in <code>config/campaign-manager.php</code>."|t('campaign-manager')|raw : null,
        }) }}

        {{ forms.textField({
            label: 'Logs Limit'|t('campaign-manager'),
            instructions: 'Maximum number of activity log records to retain'|t('campaign-manager'),
            id: 'activityLogsLimit',
            name: 'settings[activityLogsLimit]',
            type: 'number',
            value: settings.activityLogsLimit,
            required: true,
            errors: settings.getErrors('activityLogsLimit'),
            disabled: settings.isOverriddenByConfig('activityLogsLimit'),
            warning: settings.isOverriddenByConfig('activityLogsLimit') ?
                "This is being overridden by the <code>activityLogsLimit</code> setting in <code>config/campaign-manager.php</code>."|t('campaign-manager')|raw : null,
        }) }}

        {{ forms.lightswitchField({
            label: 'Auto Trim Logs'|t('campaign-manager'),
            instructions: 'Automatically trim activity logs to respect the limit'|t('campaign-manager'),
            id: 'activityAutoTrimLogs',
            name: 'settings[activityAutoTrimLogs]',
            on: settings.activityAutoTrimLogs,
            errors: settings.getErrors('activityAutoTrimLogs'),
            disabled: settings.isOverriddenByConfig('activityAutoTrimLogs'),
            warning: settings.isOverriddenByConfig('activityAutoTrimLogs') ?
                "This is being overridden by the <code>activityAutoTrimLogs</code> setting in <code>config/campaign-manager.php</code>."|t('campaign-manager')|raw : null,
        }) }}
    </div>

{% endblock %}
