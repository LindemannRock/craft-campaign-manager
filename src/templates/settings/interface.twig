{% extends 'campaign-manager/_layouts/settings' %}
{% import '_includes/forms.twig' as forms %}

{% set title = 'Interface Settings'|t('campaign-manager') %}
{% set selectedSettingsItem = 'interface' %}
{% set settingsCrumb = 'Interface'|t('campaign-manager') %}
{% set fullPageForm = true %}

{% block content %}
    {{ actionInput('campaign-manager/settings/save') }}
    {{ redirectInput('campaign-manager/settings/interface') }}
    {{ hiddenInput('section', 'interface') }}

    <h2 class="first">{{ "Interface Settings"|t('campaign-manager') }}</h2>

    {% include 'lindemannrock-base/_partials/field-items-per-page' with {
        settings: settings,
        pluginHandle: 'campaign-manager',
    } only %}

    <hr>

    {% include 'lindemannrock-base/_partials/cascade-base-overrides' with {
        settings: settings,
        pluginHandle: 'campaign-manager',
        sections: {
            dateFormat: {},
            dateRange: {},
            exports: {},
        },
    } only %}

{% endblock %}
