{#
 # Recipients Index — Using cp-table layout
 #
 # Global view of all recipients across all campaigns with filters,
 # sorting, and bulk actions.
 #
 # Follows the canonical CP table index-page pattern (SQL-paginated
 # variant) — see plugins/base/docs/template-guides/cp-table-index-pattern.md.
 # RecipientsController::actionGlobalIndex() owns query-param parsing,
 # allowlist validation, filter, sort, and pagination. This template stays
 # presentational and renders the already-sliced `recipients` plus the
 # filter/sort state handed in. Permission booleans (`canManage`, `canDelete`,
 # `canExport`) likewise arrive from the controller.
 #}

{% extends 'lindemannrock-base/_layouts/cp-table' %}

{# ============================================================================
   BUILD FILTER OPTIONS
   ============================================================================ #}

{# Campaign options #}
{% set campaignFilterOptions = [{value: 'all', label: 'All Campaigns'|t('campaign-manager'), status: 'all'}] %}
{% for option in campaignOptions %}
    {% set campaignFilterOptions = campaignFilterOptions|merge([{
        value: option.value,
        label: option.label,
    }]) %}
{% endfor %}

{# Site options #}
{% set siteFilterOptions = [{value: 'all', label: 'All Sites'|t('campaign-manager'), status: 'all'}] %}
{% for site in craft.app.sites.getEditableSites() %}
    {% set siteFilterOptions = siteFilterOptions|merge([{
        value: site.id,
        label: site.name,
    }]) %}
{% endfor %}

{# ============================================================================
   TABLE CONFIGURATION
   ============================================================================ #}

{% set tableConfig = {
    plugin: {
        handle: pluginHandle ?? 'campaign-manager',
        name: settings.fullName,
    },
    page: {
        title: 'Recipients'|t('campaign-manager'),
        subnav: 'recipients',
        crumbs: [
            { label: settings.fullName, url: url('campaign-manager') },
            { label: 'Recipients'|t('campaign-manager') }
        ],
    },
    filters: [
        {
            type: 'status',
            param: 'status',
            current: statusFilter,
            label: 'All'|t('campaign-manager'),
            colorSet: 'messageStatus',
            options: [
                {value: 'all', label: 'All'|t('campaign-manager'), status: 'all'},
                {value: 'pending', label: 'Pending'|t('campaign-manager'), colorKey: 'pending'},
                {value: 'sent', label: 'Sent'|t('campaign-manager'), colorKey: 'sent'},
            ],
        },
        {
            type: 'dropdown',
            param: 'campaign',
            current: campaignFilter,
            label: 'All Campaigns'|t('campaign-manager'),
            options: campaignFilterOptions,
        },
        {
            type: 'dropdown',
            param: 'siteFilter',
            current: siteFilterParam,
            label: 'All Sites'|t('campaign-manager'),
            options: siteFilterOptions,
        },
        {
            type: 'dateRange',
            param: 'dateRange',
            current: dateRange,
            label: 'Date Range'|t('campaign-manager'),
        },
    ],
    search: {
        placeholder: 'Search recipients...'|t('campaign-manager'),
        value: search,
    },
    sort: {
        field: sort,
        direction: dir,
    },
    table: {
        columns: [
            {key: 'name', label: 'Name'|t('campaign-manager'), sortable: true},
            {key: 'campaign', label: 'Campaign'|t('campaign-manager'), sortable: true},
            {key: 'contact', label: 'Contact'|t('campaign-manager')},
            {key: 'status', label: 'Status'|t('campaign-manager')},
            {key: 'sent', label: 'Sent'|t('campaign-manager'), sortable: true},
            {key: 'opened', label: 'Opened'|t('campaign-manager'), sortable: true},
            {key: 'response', label: 'Response'|t('campaign-manager')},
        ],
        items: recipients,
        emptyMessage: 'No recipients found.'|t('campaign-manager'),
    },
    pagination: {
        page: page,
        limit: limit,
        totalCount: totalCount,
        itemLabel: {singular: 'recipient'|t('campaign-manager'), plural: 'recipients'|t('campaign-manager')},
    },
    checkboxes: canDelete,
    rowActions: canDelete,
} %}


{# ============================================================================
   TOOLBAR ACTIONS (Export button)
   ============================================================================ #}

{% block toolbarActions %}
    {% if canExport %}
        {% include 'lindemannrock-base/_components/export-menu' with {
            action: 'campaign-manager/recipients/export',
            permission: 'campaignManager:exportRecipients',
            pluginHandle: pluginHandle,
            extraParams: {
                campaign: campaignFilter,
                siteFilter: siteFilterParam,
                status: statusFilter,
            },
        } only %}
    {% endif %}
{% endblock %}


{# ============================================================================
   BULK ACTIONS (shown when items selected)
   ============================================================================ #}

{% block bulkActions %}
    {% if canDelete %}
        {% include 'lindemannrock-base/_components/bulk-actions-menu' with {
            label: 'Actions'|t('campaign-manager'),
            countId: 'lr-bulk-actions-count',
            items: [
                {id: 'lr-bulk-delete-btn', label: 'Delete'|t('campaign-manager'), class: 'error'},
            ],
        } only %}
    {% endif %}
{% endblock %}


{# ============================================================================
   ROW ACTIONS (per-row menu)
   ============================================================================ #}

{% block rowActions %}
    {% set actionItems = [] %}

    {% if item.submissionId %}
        {% set submission = submissionMap[item.submissionId] ?? null %}
        {% if submission %}
            {% set actionItems = actionItems|merge([{
                label: 'View Response'|t('campaign-manager'),
                url: submission.cpEditUrl,
            }]) %}
        {% endif %}
    {% endif %}

    {% if canDelete %}
        {% if actionItems|length %}
            {% set actionItems = actionItems|merge([{type: 'divider'}]) %}
        {% endif %}
        {% set actionItems = actionItems|merge([{
            label: 'Delete'|t('campaign-manager'),
            class: 'error',
            jsAction: 'delete',
            data: {name: item.name},
        }]) %}
    {% endif %}

    {% if actionItems|length > 0 %}
        {% include 'lindemannrock-base/_components/row-actions' with {
            item: item,
            actions: {
                type: 'menu',
                icon: 'settings',
                title: 'Actions'|t('campaign-manager'),
                items: actionItems,
            },
        } only %}
    {% endif %}
{% endblock %}


{# ============================================================================
   CUSTOM TABLE ROW RENDERING
   ============================================================================ #}

{% block tableRow %}
    {# Get campaign and site from pre-fetched maps (controller batched the queries) #}
    {% set campaign = campaignMap[item.campaignId] ?? null %}
    {% set site = siteMap[item.siteId] ?? null %}

    {# Determine status #}
    {% if item.smsSendDate or item.emailSendDate %}
        {% set statusValue = 'sent' %}
        {% set statusLabel = 'Sent'|t('campaign-manager') %}
    {% else %}
        {% set statusValue = 'pending' %}
        {% set statusLabel = 'Pending'|t('campaign-manager') %}
    {% endif %}

    {# Name #}
    <td>
        <span>{{ item.name }}</span>
        {% if site %}
            <span class="light" style="margin-left: 4px;">({{ site.language|upper[:2] }})</span>
        {% endif %}
    </td>

    {# Campaign #}
    <td>
        {% if campaign %}
            <a href="{{ cpUrl('campaign-manager/campaigns/' ~ campaign.id, {site: site.handle ?? 'en'}) }}">
                {{ campaign.title }}
            </a>
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>

    {# Contact (Email / SMS) #}
    <td>
        {% if item.email %}
            <code style="font-size: 11px;">{{ item.email }}</code>
        {% endif %}
        {% if item.email and item.sms %}<br>{% endif %}
        {% if item.sms %}
            <code style="font-size: 11px;">{{ item.sms }}</code>
        {% endif %}
        {% if not item.email and not item.sms %}
            <span class="light">-</span>
        {% endif %}
    </td>

    {# Status indicator #}
    <td>
        {% include 'lindemannrock-base/_components/badge' with {
            label: statusLabel,
            value: statusValue,
            colorSet: 'messageStatus',
        } only %}
    </td>

    {# Sent date #}
    <td>
        {% set sentDate = item.smsSendDate ?? item.emailSendDate %}
        {% if sentDate %}
            {{ sentDate|lrDatetime }}
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>

    {# Opened date #}
    <td>
        {% set openedDate = item.smsOpenDate ?? item.emailOpenDate %}
        {% if openedDate %}
            {{ openedDate|lrDatetime }}
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>

    {# Submission #}
    <td>
        {% if item.submissionId %}
            {% set submission = submissionMap[item.submissionId] ?? null %}
            {% if submission %}
                <a href="{{ submission.cpEditUrl }}">{{ item.submissionId }}</a>
            {% else %}
                <span class="light">{{ item.submissionId }}</span>
            {% endif %}
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>
{% endblock %}


{# ============================================================================
   CUSTOM SCRIPTS
   ============================================================================ #}

{% block scripts %}
    <script>
    (function() {
        if (typeof Craft === 'undefined') return;

        // Pre-translated strings: keep |t() in Twig and emit as JSON-encoded
        // JS literals via |json_encode|raw — avoids the |e('js') trap.
        const T = {
            deleteConfirmTemplate: {{ 'Delete recipient "{name}"? This cannot be undone.'|t('campaign-manager')|json_encode|raw }},
            recipientDeleted: {{ 'Recipient deleted'|t('campaign-manager')|json_encode|raw }},
            failedToDeleteRecipient: {{ 'Failed to delete recipient'|t('campaign-manager')|json_encode|raw }},
            bulkDeleteConfirmTemplate: {{ 'Delete {count} recipient(s)? This cannot be undone.'|t('campaign-manager')|json_encode|raw }},
            bulkDeletedTemplate: {{ 'Deleted {count} recipients'|t('campaign-manager')|json_encode|raw }},
            bulkDeleteFailed: {{ 'Failed to delete recipients'|t('campaign-manager')|json_encode|raw }},
        };

        function selectedIds() {
            return window.lrTableSelection ? window.lrTableSelection.getSelectedIds() : [];
        }

        // ---------------------------------------------------------------------
        // Row-action handlers. Delegated listener on `document`, narrowed by
        // `a[data-action]` + an explicit action-name allowlist. preventDefault
        // only after the match. See cp-table-index-pattern.md.
        // ---------------------------------------------------------------------
        document.addEventListener('click', function(e) {
            const trigger = e.target.closest('a[data-action]');
            if (!trigger) return;

            const action = trigger.dataset.action;
            if (action !== 'delete') return;

            const id = trigger.dataset.id;
            const name = trigger.dataset.name || '';
            if (!id) return;
            e.preventDefault();

            if (!confirm(T.deleteConfirmTemplate.replace('{name}', name))) return;

            Craft.sendActionRequest('POST', 'campaign-manager/recipients/delete-from-cp', {
                data: { id: id },
            }).then(function(response) {
                const data = response && response.data;
                if (data && data.success) {
                    Craft.cp.displayNotice(T.recipientDeleted);
                    setTimeout(function() { window.location.reload(); }, 1000);
                } else {
                    Craft.cp.displayError((data && data.error) || T.failedToDeleteRecipient);
                }
            }).catch(function() {
                Craft.cp.displayError(T.failedToDeleteRecipient);
            });
        });

        // Bulk delete
        document.getElementById('lr-bulk-delete-btn')?.addEventListener('click', function() {
            const ids = selectedIds();
            if (!ids.length) return;
            if (!confirm(T.bulkDeleteConfirmTemplate.replace('{count}', ids.length))) return;

            Craft.sendActionRequest('POST', 'campaign-manager/recipients/bulk-delete', {
                data: { recipientIds: ids },
            }).then(function(response) {
                const count = response.data.count || 0;
                if (count > 0) {
                    Craft.cp.displayNotice(T.bulkDeletedTemplate.replace('{count}', count));
                }
                if (Array.isArray(response.data.errors)) {
                    response.data.errors.forEach(function(err) { Craft.cp.displayError(err); });
                }
                if (count > 0) {
                    setTimeout(function() { window.location.reload(); }, 1000);
                }
            }).catch(function() {
                Craft.cp.displayError(T.bulkDeleteFailed);
            });
        });
    })();
    </script>
{% endblock %}
