{#
 # Per-campaign Recipients listing — Using cp-table layout.
 #
 # Scoped to a single campaign + site (locked via URL, not filterable).
 # Filters available: status, date range, search. Sort + paginate handled
 # by base cp-table. All filter/sort/pagination data is prepared by the
 # controller (no per-row queries in this template).
 #}

{% extends 'lindemannrock-base/_layouts/cp-table' %}

{# ============================================================================
   PERMISSION CHECKS
   ============================================================================ #}

{% set canAdd = currentUser.can('campaignManager:addRecipients') %}
{% set canImport = currentUser.can('campaignManager:importRecipients') %}
{% set canDelete = currentUser.can('campaignManager:deleteRecipients') %}
{% set canRun = currentUser.can('campaignManager:runCampaigns') %}
{% set canExport = currentUser.can('campaignManager:exportRecipients') %}

{# ============================================================================
   FALLBACKS (controller passes these, but guard against direct render)
   ============================================================================ #}

{% set search = search ?? craft.app.request.getParam('search', '') %}
{% set statusFilter = statusFilter ?? craft.app.request.getParam('status', 'all') %}
{% set dateRange = dateRange ?? craft.app.request.getParam('dateRange', defaultDateRange ?? 'last30days') %}
{% set sort = sort ?? craft.app.request.getParam('sort', 'sent') %}
{% set dir = dir ?? craft.app.request.getParam('dir', 'desc') %}
{% set page = page ?? craft.app.request.getParam('page', 1)|number_format(0, '', '') %}
{% set limit = limit ?? 50 %}
{% set totalCount = totalCount ?? 0 %}
{% set recipients = recipients ?? [] %}
{% set submissionMap = submissionMap ?? {} %}

{# ============================================================================
   CRUMBS — site switcher (if multi-site) + plugin + campaign + page label
   ============================================================================ #}

{% set crumbs = [] %}
{% if craft.app.getIsMultiSite() %}
    {% set siteMenuItems = [] %}
    {% for s in craft.app.sites.getEditableSites() %}
        {% set siteMenuItems = siteMenuItems|merge([{
            label: s.name,
            url: cpUrl('campaign-manager/campaigns/' ~ campaignId ~ '/recipients', {site: s.handle}),
            selected: s.handle == site.handle,
        }]) %}
    {% endfor %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: site.name|t('site'),
        menu: { items: siteMenuItems, label: 'Select site'|t('app') },
    }] %}
{% endif %}
{% set crumbs = crumbs|merge([
    { label: settings.fullName, url: cpUrl('campaign-manager', {site: site.handle}) },
    { label: campaign.title, url: cpUrl('campaign-manager/campaigns/' ~ campaignId, {site: site.handle}) },
    { label: 'Recipients'|t('campaign-manager') },
]) %}

{# ============================================================================
   TABLE CONFIGURATION
   ============================================================================ #}

{% set tableConfig = {
    plugin: {
        handle: pluginHandle ?? 'campaign-manager',
        name: settings.fullName,
    },
    page: {
        title: campaign.title ~ ' — ' ~ 'Recipients'|t('campaign-manager'),
        subnav: 'campaigns',
        crumbs: crumbs,
    },
    filters: [
        {
            type: 'status',
            param: 'status',
            current: statusFilter,
            label: 'All'|t('campaign-manager'),
            colorSet: 'messageStatus',
            options: [
                {value: 'all', label: 'All'|t('campaign-manager'), status: 'all'},
                {value: 'pending', label: 'Pending'|t('campaign-manager'), colorKey: 'pending'},
                {value: 'sent', label: 'Sent'|t('campaign-manager'), colorKey: 'sent'},
            ],
        },
        {
            type: 'dateRange',
            param: 'dateRange',
            current: dateRange,
            label: 'Date Range'|t('campaign-manager'),
        },
    ],
    search: {
        placeholder: 'Search recipients...'|t('campaign-manager'),
        value: search,
    },
    sort: {
        field: sort,
        direction: dir,
    },
    table: {
        columns: [
            {key: 'name', label: 'Name'|t('campaign-manager'), sortable: true},
            {key: 'contact', label: 'Contact'|t('campaign-manager')},
            {key: 'code', label: 'Code'|t('campaign-manager')},
            {key: 'status', label: 'Status'|t('campaign-manager')},
            {key: 'sent', label: 'Sent'|t('campaign-manager'), sortable: true},
            {key: 'opened', label: 'Opened'|t('campaign-manager'), sortable: true},
            {key: 'response', label: 'Response'|t('campaign-manager')},
        ],
        items: recipients,
        emptyMessage: 'No recipients found.'|t('campaign-manager'),
    },
    pagination: {
        page: page,
        limit: limit,
        totalCount: totalCount,
        itemLabel: {singular: 'recipient'|t('campaign-manager'), plural: 'recipients'|t('campaign-manager')},
    },
} %}


{# ============================================================================
   TOOLBAR ACTIONS (Export + Add menu + Run Campaign)
   ============================================================================ #}

{% block toolbarActions %}
    {% if canExport %}
        {% include 'lindemannrock-base/_components/export-menu' with {
            action: 'campaign-manager/recipients/export-recipients',
            permission: 'campaignManager:exportRecipients',
            pluginHandle: pluginHandle ?? 'campaign-manager',
            extraParams: {
                campaignId: campaignId,
                site: site.handle,
                dateRange: dateRange,
                status: statusFilter,
            },
        } only %}
    {% endif %}

    {% if campaign.getEnabledForSite() and (canAdd or canImport) %}
        <div class="btngroup">
            <button type="button" class="btn menubtn" data-icon="plus">{{ 'Add'|t('campaign-manager') }}</button>
            <div class="menu" data-align="right">
                <ul>
                    {% if canAdd %}
                        <li>
                            <a href="{{ cpUrl('campaign-manager/campaigns/' ~ campaign.id ~ '/add-recipient', {site: site.handle}) }}">
                                {{ 'Add Recipient'|t('campaign-manager') }}
                            </a>
                        </li>
                    {% endif %}
                    {% if canImport %}
                        <li>
                            <a href="{{ cpUrl('campaign-manager/campaigns/' ~ campaign.id ~ '/import-recipients', {site: site.handle}) }}">
                                {{ 'Import Recipients'|t('campaign-manager') }}
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    {% endif %}

    {% if campaign.getEnabledForSite() and canRun %}
        <button type="button" class="btn submit" id="run-campaign-btn" data-campaign-id="{{ campaignId }}" data-site-id="{{ site.id }}">
            {{ 'Run Campaign'|t('campaign-manager') }}
        </button>
    {% endif %}
{% endblock %}


{# ============================================================================
   ROW ACTIONS (per-row menu)
   ============================================================================ #}

{% block rowActions %}
    {% if canDelete %}
        <td class="thin" style="text-align: right;">
            <button type="button" class="btn menubtn" data-icon="settings" title="{{ 'Actions'|t('app') }}"></button>
            <div class="menu">
                <ul>
                    <li>
                        <a class="recipient-action error" data-action="delete" data-id="{{ item.id }}" data-name="{{ item.name }}">
                            {{ 'Delete'|t('app') }}
                        </a>
                    </li>
                </ul>
            </div>
        </td>
    {% endif %}
{% endblock %}


{# ============================================================================
   CUSTOM ROW RENDERING
   ============================================================================ #}

{% block tableRow %}
    {# Status #}
    {% if item.smsSendDate or item.emailSendDate %}
        {% set statusValue = 'sent' %}
        {% set statusLabel = 'Sent'|t('campaign-manager') %}
    {% else %}
        {% set statusValue = 'pending' %}
        {% set statusLabel = 'Pending'|t('campaign-manager') %}
    {% endif %}

    {# Name #}
    <td>{{ item.name }}</td>

    {# Contact (email + sms) #}
    <td>
        {% if item.email %}<code style="font-size: 11px;">{{ item.email }}</code>{% endif %}
        {% if item.email and item.sms %}<br>{% endif %}
        {% if item.sms %}<code style="font-size: 11px;">{{ item.sms }}</code>{% endif %}
        {% if not item.email and not item.sms %}<span class="light">-</span>{% endif %}
    </td>

    {# Invitation code #}
    <td><code>{{ item.smsInvitationCode ?? item.emailInvitationCode ?? '-' }}</code></td>

    {# Status badge #}
    <td>
        {% include 'lindemannrock-base/_components/badge' with {
            label: statusLabel,
            value: statusValue,
            colorSet: 'messageStatus',
        } only %}
    </td>

    {# Sent date #}
    <td>
        {% set sentDate = item.smsSendDate ?? item.emailSendDate %}
        {% if sentDate %}
            {{ sentDate|lrDatetime('medium') }}
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>

    {# Opened date #}
    <td>
        {% set openedDate = item.smsOpenDate ?? item.emailOpenDate %}
        {% if openedDate %}
            {{ openedDate|lrDatetime('medium') }}
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>

    {# Response #}
    <td>
        {% if item.submissionId %}
            {% set submission = submissionMap[item.submissionId] ?? null %}
            {% if submission %}
                <a href="{{ submission.cpEditUrl }}">{{ item.submissionId }}</a>
            {% else %}
                <span class="light">{{ item.submissionId }}</span>
            {% endif %}
        {% else %}
            <span class="light">-</span>
        {% endif %}
    </td>
{% endblock %}


{# ============================================================================
   SCRIPTS (Run Campaign + per-row delete)
   ============================================================================ #}

{% block scripts %}
    <script>
    (function() {
        // Run campaign button
        document.getElementById('run-campaign-btn')?.addEventListener('click', function() {
            const campaignId = this.dataset.campaignId;
            const siteId = this.dataset.siteId;

            Craft.sendActionRequest('POST', 'campaign-manager/campaigns/run-all', {
                data: { campaignId: campaignId, siteId: siteId }
            }).then(function(response) {
                if (response.data.success) {
                    const jobsQueued = response.data.jobsQueued || 0;
                    if (jobsQueued > 0) {
                        const queueUrl = {{ cpUrl('utilities/queue-manager')|json_encode|raw }};
                        const queueMsg = {{ 'Campaign job queued. Check the queue for progress.'|t('campaign-manager')|json_encode|raw }};
                        Craft.cp.displayNotice(queueMsg, {
                            details: $('<a/>', {href: queueUrl, text: Craft.t('app', 'View')}),
                        });
                    } else {
                        Craft.cp.displayNotice({{ 'No pending recipients to process.'|t('campaign-manager')|json_encode|raw }});
                    }
                }
            }).catch(function(error) {
                Craft.cp.displayError({{ 'Failed to run campaign'|t('campaign-manager')|json_encode|raw }});
            });
        });

        // Per-row delete
        document.querySelectorAll('.recipient-action').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const action = this.dataset.action;
                const recipientId = this.dataset.id;
                const recipientName = this.dataset.name;

                if (action !== 'delete') return;
                if (!confirm({{ 'Delete recipient "{name}"? This cannot be undone.'|t('campaign-manager')|json_encode|raw }}.replace('{name}', recipientName))) {
                    return;
                }

                Craft.sendActionRequest('POST', 'campaign-manager/recipients/delete-from-cp', {
                    data: { id: recipientId }
                }).then(function(response) {
                    var data = response && response.data;
                    if (data && data.success) {
                        Craft.cp.displayNotice({{ 'Recipient deleted'|t('campaign-manager')|json_encode|raw }});
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        Craft.cp.displayError((data && data.error) || {{ 'Failed to delete recipient'|t('campaign-manager')|json_encode|raw }});
                    }
                }).catch(function(error) {
                    Craft.cp.displayError({{ 'Failed to delete recipient'|t('campaign-manager')|json_encode|raw }});
                });
            });
        });
    })();
    </script>
{% endblock %}
