{% extends '_layouts/cp' %}
{% import '_includes/forms.twig' as forms %}

{% set plugin = craft.app.plugins.getPlugin('campaign-manager') %}
{% set settings = plugin.getSettings() %}
{% set selectedSubnavItem = 'campaigns' %}

{# Get site info for orientation (RTL support) #}
{% set currentSite = craft.app.sites.getSiteById(campaign.siteId) %}
{% set siteLocale = craft.app.i18n.getLocaleById(currentSite.language) %}
{% set siteOrientation = siteLocale.getOrientation() %}

{# Set up breadcrumbs #}
{% set crumbs = [] %}

{# Site switcher (first item) #}
{% if craft.app.getIsMultiSite() %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: currentSite.name|t('site'),
        menu: {
            items: siteMenuItems(null, currentSite),
            label: 'Select site'|t('campaign-manager')
        }
    }] %}
{% endif %}

{# Main navigation #}
{% set crumbs = crumbs|merge([
    { label: settings.pluginName, url: cpUrl('campaign-manager') }
]) %}

{# Add campaign title or "New Campaign" crumb #}
{% if campaign.id %}
    {% set crumbs = crumbs|merge([
        { label: campaign.title }
    ]) %}
{% else %}
    {% set crumbs = crumbs|merge([
        { label: 'New Campaign'|t('campaign-manager') }
    ]) %}
{% endif %}

{% set fullPageForm = true %}
{% set saveShortcutRedirect = 'campaign-manager/campaigns/{id}?site=' ~ currentSite.handle %}

{# Set up tabs #}
{% set tabs = {
    'fields': { label: 'General'|t('campaign-manager'), url: '#fields' },
} %}

{# Add Analytics tab for existing campaigns (requires permission and enabled setting) #}
{% if campaign.id and currentUser.can('campaignManager:viewAnalytics') %}
    {% set tabs = tabs|merge({
        'analytics': { label: 'Analytics'|t('campaign-manager'), url: '#analytics' },
    }) %}
{% endif %}

{# Add Responses tab for existing campaigns with a form (requires permission) #}
{% if campaign.id and campaign.formId and currentUser.can('campaignManager:manageRecipients') %}
    {% set tabs = tabs|merge({
        'responses': { label: 'Responses'|t('campaign-manager'), url: '#responses' },
    }) %}
{% endif %}

{# Get field layout for rendering in General tab #}
{% set fieldLayout = campaign.getFieldLayout() %}

{% block actionButton %}
    <div class="btngroup submit">
        <button type="submit" class="btn submit">{{ 'Save'|t('campaign-manager') }}</button>
        <button type="button" class="btn submit menubtn"></button>
        <div class="menu">
            <ul role="listbox">
                <li>
                    <a class="formsubmit" role="option" tabindex="0" data-redirect="{{ url('campaign-manager/campaigns/{id}', {site: currentSite.handle})|hash }}">
                        <span class="label">{{ 'Save and continue editing'|t('campaign-manager') }}</span>
                        <span class="shortcut" id="save-shortcut"></span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    {% if campaign.id and currentUser.can('campaignManager:deleteCampaigns') %}
        <button type="button" id="action-btn" class="btn menubtn action-btn hairline-dark m" title="{{ 'Actions'|t('campaign-manager') }}" aria-controls="action-menu" aria-label="{{ 'Actions'|t('campaign-manager') }}" data-disclosure-trigger="true" aria-expanded="false"></button>
        <div id="action-menu" class="menu menu--disclosure">
            <ul>
                <li>
                    <button class="menu-item error formsubmit" data-destructive data-action="campaign-manager/campaigns/delete" data-params='{"campaignId":{{ campaign.id }}}' data-confirm="{{ 'Are you sure you want to delete this campaign?'|t('campaign-manager') }}" data-redirect="{{ 'campaign-manager'|hash }}" data-headers='{"Accept":"application/json"}'>
                        <span class="icon">{{ svg('@app/icons/trash.svg') }}</span>
                        <span class="menu-item-label">{{ 'Delete'|t('campaign-manager') }}</span>
                    </button>
                </li>
            </ul>
        </div>
    {% endif %}
{% endblock %}

{% if campaign is defined and campaign.hasErrors() %}
    {% set errorSummary %}
        {% include 'lindemannrock-base/_partials/error-summary' with {
            errors: campaign.getErrors(),
            linkMode: 'field-id',
            translationCategory: 'campaign-manager'
        } %}
    {% endset %}
{% endif %}

{% block content %}
    {{ actionInput('campaign-manager/campaigns/save') }}
    {{ redirectInput('campaign-manager') }}
    {{ hiddenInput('siteId', campaign.siteId) }}
    {% if campaign.id %}
        {{ hiddenInput('campaignId', campaign.id) }}
    {% endif %}

    {# Duration units for invitation settings #}
    {% set durationUnits = [
        {label: 'Hours'|t('campaign-manager'), value: 'H'},
        {label: 'Days'|t('campaign-manager'), value: 'D'},
        {label: 'Weeks'|t('campaign-manager'), value: 'W'},
        {label: 'Months'|t('campaign-manager'), value: 'M'},
    ] %}

    {# Parse existing delay period - default to Hours #}
    {% set delayValue = '' %}
    {% set delayUnit = 'H' %}
    {% if campaign.invitationDelayPeriod matches '/^P(\\d+)([DWM])$/' %}
        {% set delayValue = campaign.invitationDelayPeriod|replace('/[^0-9]/', '') %}
        {% set delayUnit = campaign.invitationDelayPeriod|slice(-1) %}
    {% elseif campaign.invitationDelayPeriod matches '/^PT(\\d+)H$/' %}
        {% set delayValue = campaign.invitationDelayPeriod|replace('/[^0-9]/', '') %}
        {% set delayUnit = 'H' %}
    {% endif %}

    {# Parse existing expiry period - default to Days #}
    {% set expiryValue = '' %}
    {% set expiryUnit = 'D' %}
    {% if campaign.invitationExpiryPeriod matches '/^P(\\d+)([DWM])$/' %}
        {% set expiryValue = campaign.invitationExpiryPeriod|replace('/[^0-9]/', '') %}
        {% set expiryUnit = campaign.invitationExpiryPeriod|slice(-1) %}
    {% elseif campaign.invitationExpiryPeriod matches '/^PT(\\d+)H$/' %}
        {% set expiryValue = campaign.invitationExpiryPeriod|replace('/[^0-9]/', '') %}
        {% set expiryUnit = 'H' %}
    {% endif %}

    {# ==================== MAIN TAB ==================== #}
    <div id="fields">
        {# Title #}
        {{ forms.textField({
            label: 'Title'|t('campaign-manager'),
            id: 'title',
            name: 'title',
            value: campaign.title,
            errors: campaign.getErrors('title'),
            first: true,
            autofocus: true,
            required: true,
            translatable: craft.app.getIsMultiSite() ? 'site' : false,
            orientation: siteOrientation,
        }) }}

        {# Campaign Type #}
        {% if campaignTypeOptions %}
            {{ forms.selectField({
                label: 'Campaign Type'|t('campaign-manager'),
                id: 'campaignType',
                name: 'campaignType',
                value: campaign.campaignType,
                options: [{label: '', value: ''}]|merge(campaignTypeOptions|keys|map(k => {label: campaignTypeOptions[k], value: k})),
                errors: campaign.getErrors('campaignType'),
            }) }}
        {% endif %}

        {# Form - check ALL sites for responses since form is shared across sites #}
        {% if formOptions|length %}
            {% set hasResponses = campaign.id and campaign.hasSubmissionsAcrossAllSites() %}
            {{ forms.selectField({
                label: 'Form'|t('campaign-manager'),
                instructions: 'Select a Formie form to link with this campaign.'|t('campaign-manager'),
                id: 'formId',
                name: 'formId',
                value: campaign.formId,
                options: [{label: 'Select a form'|t('campaign-manager'), value: ''}]|merge(formOptions),
                errors: campaign.getErrors('formId'),
                required: true,
                disabled: hasResponses,
            }) }}
            {% if hasResponses %}
                {# Hidden input to preserve value when disabled #}
                {{ hiddenInput('formId', campaign.formId) }}
                {% include 'lindemannrock-base/_components/info-box' with {
                    type: 'warning',
                    message: 'The form cannot be changed because this campaign has responses. Changing the form would break existing response data.'|t('campaign-manager'),
                    margin: 'top',
                } %}
            {% endif %}
        {% endif %}

        <hr>

        <h2>{{ 'Invitation Settings'|t('campaign-manager') }}</h2>

        {# Invitation Delay Period #}
        <div class="field">
            <div class="heading">
                <label for="invitationDelayValue">{{ 'Invitation Delay'|t('campaign-manager') }}</label>
            </div>
            <div class="instructions">
                <p>{{ 'How long to wait before sending invitations after a recipient is added. Leave empty or 0 to send immediately.'|t('campaign-manager') }}</p>
            </div>
            <div class="flex">
                <div class="textwrapper">
                    {{ forms.text({
                        id: 'invitationDelayValue',
                        name: 'invitationDelayValue',
                        value: delayValue,
                        type: 'number',
                        min: 0,
                        size: 5,
                        placeholder: '0',
                    }) }}
                </div>
                <div>
                    {{ forms.select({
                        id: 'invitationDelayUnit',
                        name: 'invitationDelayUnit',
                        value: delayUnit,
                        options: durationUnits,
                    }) }}
                </div>
            </div>
            {% if campaign.getErrors('invitationDelayPeriod') %}
                <ul class="errors">
                    {% for error in campaign.getErrors('invitationDelayPeriod') %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        {# Invitation Expiry Period #}
        <div class="field">
            <div class="heading">
                <label for="invitationExpiryValue">{{ 'Invitation Expiry'|t('campaign-manager') }}</label>
            </div>
            <div class="instructions">
                <p>{{ 'How long the invitation link remains valid.'|t('campaign-manager') }}</p>
            </div>
            <div class="flex">
                <div class="textwrapper">
                    {{ forms.text({
                        id: 'invitationExpiryValue',
                        name: 'invitationExpiryValue',
                        value: expiryValue,
                        type: 'number',
                        min: 0,
                        size: 5,
                        placeholder: '0',
                    }) }}
                </div>
                <div>
                    {{ forms.select({
                        id: 'invitationExpiryUnit',
                        name: 'invitationExpiryUnit',
                        value: expiryUnit,
                        options: durationUnits,
                    }) }}
                </div>
            </div>
            {% if campaign.getErrors('invitationExpiryPeriod') %}
                <ul class="errors">
                    {% for error in campaign.getErrors('invitationExpiryPeriod') %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <hr>

        {# ==================== MESSAGING SECTION (SMS + Email) ==================== #}
        <h2>{{ 'SMS Settings'|t('campaign-manager') }}</h2>

        {% if craft.campaignManager.sms.isSmsManagerAvailable() %}
            {# Single Sender ID dropdown with `<optgroup>` provider groupings.
               `CampaignRecord::beforeValidate()` auto-syncs `providerHandle`
               from the chosen sender so recipients pages keep working. #}

            {# Build sender→provider + country lookup maps for the JS-side
               country preview update on dropdown change. #}
            {% set senderToProvider = {} %}
            {% set countriesByProvider = {} %}
            {% set providerNames = {} %}
            {% set countryNames = {} %}
            {% for provider in craft.campaignManager.sms.getAvailableProviders() %}
                {% set countries = craft.campaignManager.sms.getAllowedCountries(provider.handle) %}
                {% set countriesByProvider = countriesByProvider|merge({(provider.handle): countries}) %}
                {% set providerNames = providerNames|merge({(provider.handle): provider.name}) %}
                {% for code in countries %}
                    {% if code != '*' and countryNames[code] is not defined %}
                        {% set countryNames = countryNames|merge({(code): lrCountryName(code)}) %}
                    {% endif %}
                {% endfor %}
                {% for sender in craft.campaignManager.sms.getAvailableSenderIds(provider.handle) %}
                    {% set senderToProvider = senderToProvider|merge({(sender.handle): provider.handle}) %}
                {% endfor %}
            {% endfor %}

            {# Provider that the "Use SMS Manager default" sentinel currently
               resolves to. Used for the country preview when the campaign's
               saved sender is the sentinel (`''`). #}
            {% set defaultSenderProviderHandle = craft.campaignManager.sms.getResolvedDefaultSenderProvider() %}

            {# Pre-select: prefer the campaign's own senderId; if it's null
               (new campaign), fall through to the plugin's default sender. #}
            {% set currentSenderIdHandle = campaign.senderId ?: settings.defaultSenderIdHandle %}
            {{ forms.selectField({
                label: 'Sender ID'|t('campaign-manager'),
                instructions: 'Senders are grouped by their provider. Pick "Use SMS Manager default" to follow whatever is configured plugin-wide; pick a specific sender to pin this campaign to that sender regardless of future default changes.'|t('campaign-manager'),
                id: 'senderId',
                name: 'senderId',
                value: currentSenderIdHandle,
                options: senderIdOptions,
                errors: campaign.getErrors('senderId'),
            }) }}

            {# Country preview — resolve provider from the pre-selected sender. #}
            {% if currentSenderIdHandle is same as('') %}
                {% set previewProviderHandle = defaultSenderProviderHandle %}
            {% elseif currentSenderIdHandle %}
                {% set previewProviderHandle = senderToProvider[currentSenderIdHandle] ?? null %}
            {% else %}
                {% set previewProviderHandle = null %}
            {% endif %}

            {% set previewProvider = null %}
            {% if previewProviderHandle %}
                {% for provider in craft.campaignManager.sms.getAvailableProviders() %}
                    {% if provider.handle == previewProviderHandle %}
                        {% set previewProvider = provider %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            {% set previewCountries = previewProviderHandle ? (countriesByProvider[previewProviderHandle] ?? []) : [] %}
            {% set formattedCountries = [] %}
            {% for code in previewCountries %}
                {% if code != '*' %}
                    {% set formattedCountries = formattedCountries|merge([lrCountryName(code) ~ ' (' ~ code ~ ')']) %}
                {% endif %}
            {% endfor %}
            {% set countryMessage = previewCountries == ['*']
                ? 'Allowed countries for <strong>' ~ (previewProvider.name ?? '') ~ '</strong>: All countries.'
                : 'Allowed countries for <strong>' ~ (previewProvider.name ?? '') ~ '</strong>: ' ~ formattedCountries|join(', ') ~ '.' %}
            {% include 'lindemannrock-base/_components/info-box' with {
                message: countryMessage,
                type: 'info',
                margin: 'top',
                boxId: 'campaign-provider-countries-box',
                messageId: 'campaign-provider-countries-message',
                hidden: not previewProviderHandle,
            } %}

            {% js %}
                (function() {
                    var senderToProvider = {{ senderToProvider|json_encode|raw }};
                    var countriesByProvider = {{ countriesByProvider|json_encode|raw }};
                    var providerNames = {{ providerNames|json_encode|raw }};
                    var countryNames = {{ countryNames|json_encode|raw }};
                    var defaultSenderProviderHandle = {{ (defaultSenderProviderHandle ?? '')|json_encode|raw }};
                    var senderIdSelect = document.getElementById('senderId');
                    var countriesBox = document.getElementById('campaign-provider-countries-box');
                    var countriesMessage = document.getElementById('campaign-provider-countries-message');

                    function formatCountry(code) {
                        var name = countryNames[code] || code;
                        return name + ' (' + code + ')';
                    }

                    function resolveProviderForSender(senderHandle) {
                        if (senderHandle === '') {
                            // "Use SMS Manager default" sentinel.
                            return defaultSenderProviderHandle;
                        }
                        return senderToProvider[senderHandle] || '';
                    }

                    function updateCountries() {
                        if (!countriesBox || !countriesMessage) {
                            return;
                        }
                        var providerHandle = resolveProviderForSender(senderIdSelect.value);
                        if (!providerHandle) {
                            countriesBox.style.display = 'none';
                            return;
                        }
                        var countries = countriesByProvider[providerHandle] || [];
                        var providerName = providerNames[providerHandle] || providerHandle;
                        var message;
                        if (countries.length === 1 && countries[0] === '*') {
                            message = {{ 'Allowed countries for'|t('campaign-manager')|json_encode|raw }} + ' <strong>' + providerName + '</strong>: ' + {{ 'All countries.'|t('campaign-manager')|json_encode|raw }};
                        } else if (countries.length > 0) {
                            var formatted = countries.map(formatCountry).join(', ');
                            message = {{ 'Allowed countries for'|t('campaign-manager')|json_encode|raw }} + ' <strong>' + providerName + '</strong>: ' + formatted + '.';
                        } else {
                            message = {{ 'No country restrictions for'|t('campaign-manager')|json_encode|raw }} + ' <strong>' + providerName + '</strong>.';
                        }
                        countriesMessage.innerHTML = message;
                        countriesBox.style.display = '';
                    }

                    senderIdSelect.addEventListener('change', updateCountries);
                })();
            {% endjs %}
        {% else %}
            {% include 'lindemannrock-base/_components/info-box' with {
                type: 'notice',
                message: 'SMS Manager plugin is not installed or enabled. <a href="' ~ cpUrl('settings/plugins') ~ '">Enable SMS Manager</a> to configure SMS settings.'|t('campaign-manager')
            } %}
        {% endif %}

        {# SMS Invitation Message #}
        {{ forms.textareaField({
            label: 'SMS Invitation Message'|t('campaign-manager'),
            instructions: 'Use {name} to personalize and {link} to include the invitation URL.'|t('campaign-manager'),
            id: 'smsInvitationMessage',
            name: 'smsInvitationMessage',
            value: campaign.smsInvitationMessage,
            rows: 3,
            errors: campaign.getErrors('smsInvitationMessage'),
            translatable: craft.app.getIsMultiSite() ? 'site' : false,
            orientation: siteOrientation,
        }) }}

        <hr>

        <h2>{{ 'Email Settings'|t('campaign-manager') }}</h2>

        {# Email Subject #}
        {{ forms.textField({
            label: 'Email Invitation Subject'|t('campaign-manager'),
            instructions: 'Use {name} to personalize.'|t('campaign-manager'),
            id: 'emailInvitationSubject',
            name: 'emailInvitationSubject',
            value: campaign.emailInvitationSubject,
            errors: campaign.getErrors('emailInvitationSubject'),
            translatable: craft.app.getIsMultiSite() ? 'site' : false,
            orientation: siteOrientation,
        }) }}

        {# Email Invitation Message #}
        {{ forms.textareaField({
            label: 'Email Invitation Message'|t('campaign-manager'),
            instructions: 'Use {name} to personalize and {link} to include the invitation URL. HTML is supported.'|t('campaign-manager'),
            id: 'emailInvitationMessage',
            name: 'emailInvitationMessage',
            value: campaign.emailInvitationMessage,
            rows: 6,
            errors: campaign.getErrors('emailInvitationMessage'),
            translatable: craft.app.getIsMultiSite() ? 'site' : false,
            orientation: siteOrientation,
        }) }}

        {# ==================== FIELD LAYOUT CONTENT ==================== #}
        {% if fieldLayout %}
            {% for tab in fieldLayout.getTabs() %}
                {% if tab.getElements()|length %}
                    <hr>
                    <h2>{{ tab.name }}</h2>
                    {% for element in tab.getElements() %}
                        {{ element.formHtml(campaign)|raw }}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}
    </div>

    {#
     # ANALYTICS / RESPONSES TABS
     #
     # On first page load, render empty placeholders + spinner — partials are
     # fetched lazily via AJAX after the edit form is interactive (avoids blocking
     # TTFB on heavy analytics queries when user only wants to edit settings).
     #
     # On AJAX requests (?ajax=1), render partials inline. This is what lets the
     # base analytics-panel's own filter AJAX work natively: it fetches the page
     # URL with ?ajax=1, finds its panel by ID in the response, and swaps it in
     # place — overlay loader, content stays visible, no flash.
     #}
    {% set isPanelAjax = craft.app.request.getQueryParam('ajax') == '1' %}

    {# ==================== ANALYTICS TAB ==================== #}
    {% if campaign.id and currentUser.can('campaignManager:viewAnalytics') %}
        {% if isPanelAjax %}
            <div id="analytics" class="hidden">
                {% include 'campaign-manager/campaigns/_partials/analytics' %}
            </div>
        {% else %}
            <div id="analytics"
                 class="lr-tab-lazy hidden"
                 data-tab-name="analytics"
                 data-tab-loaded="false">
                <div class="lr-tab-loading"><div class="spinner"></div></div>
            </div>
        {% endif %}
    {% endif %}

    {# ==================== RESPONSES TAB ==================== #}
    {% if campaign.id and campaign.formId and currentUser.can('campaignManager:manageRecipients') %}
        {% if isPanelAjax %}
            <div id="responses" class="hidden">
                {% include 'campaign-manager/campaigns/_partials/responses' %}
            </div>
        {% else %}
            <div id="responses"
                 class="lr-tab-lazy hidden"
                 data-tab-name="responses"
                 data-tab-loaded="false">
                <div class="lr-tab-loading"><div class="spinner"></div></div>
            </div>
        {% endif %}
    {% endif %}

    {# Lazy-load tab content on first activation #}
    {% if campaign.id and not isPanelAjax %}
        {# Pre-register base assets so styles + Chart.js are on the page before AJAX-loaded tab content runs #}
        {% do view.registerAssetBundle('lindemannrock\\base\\web\\assets\\components\\ComponentsAsset') %}
        {% if currentUser.can('campaignManager:viewAnalytics') %}
            {% do view.registerAssetBundle('lindemannrock\\base\\web\\assets\\analytics\\AnalyticsAsset') %}
        {% endif %}

        {% set tabLoadEndpoint = actionUrl('campaign-manager/campaigns/render-tab') %}
        {% set tabLoadParams = {
            campaignId: campaign.id,
            site: currentSite.handle,
        } %}
        <style>
            .lr-tab-loading {
                display: flex;
                justify-content: center;
                padding: 48px 24px;
            }
            .lr-tab-error {
                padding: 24px;
                color: #b91c1c;
            }
            .lr-tab-lazy[data-tab-loaded="true"] .lr-tab-loading {
                display: none;
            }
        </style>
        <script>
            (function() {
                var endpoint = {{ tabLoadEndpoint|json_encode|raw }};
                var baseParams = {{ tabLoadParams|json_encode|raw }};
                var errorMsg = {{ 'Failed to load tab content.'|t('campaign-manager')|json_encode|raw }};

                // innerHTML doesn't execute <script> tags — re-attach as live elements so they run.
                function executeScripts(container) {
                    container.querySelectorAll('script').forEach(function(oldScript) {
                        var newScript = document.createElement('script');
                        if (oldScript.src) {
                            newScript.src = oldScript.src;
                        } else {
                            newScript.textContent = oldScript.textContent;
                        }
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                }

                function loadTab(panel) {
                    if (panel.dataset.tabLoaded === 'true' || panel.dataset.tabLoading === 'true') {
                        return;
                    }
                    panel.dataset.tabLoading = 'true';

                    var params = new URLSearchParams(window.location.search);
                    Object.keys(baseParams).forEach(function(key) {
                        params.set(key, baseParams[key]);
                    });
                    params.set('tab', panel.dataset.tabName);

                    var url = endpoint + (endpoint.indexOf('?') === -1 ? '?' : '&') + params.toString();

                    fetch(url, {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    })
                        .then(function(res) {
                            if (!res.ok) throw new Error('HTTP ' + res.status);
                            return res.json();
                        })
                        .then(function(data) {
                            panel.innerHTML = data.html || '';
                            executeScripts(panel);

                            // Re-init Craft menu buttons in the new content (used by filters)
                            panel.querySelectorAll('.menubtn').forEach(function(btn) {
                                if (typeof Craft !== 'undefined' && Craft.MenuBtn) {
                                    new Craft.MenuBtn(btn);
                                } else if (typeof Garnish !== 'undefined' && Garnish.MenuBtn) {
                                    new Garnish.MenuBtn(btn);
                                }
                            });

                            // The base analytics-panel registers its lr:panelChartsReady listener on
                            // DOMContentLoaded — which has already fired by now. Dispatch it ourselves
                            // once Chart.js is confirmed loaded so the partial's chart init runs.
                            // On first visit Chart.js may still be loading (async asset bundle), so
                            // poll briefly until it's available before dispatching.
                            if (typeof Chart !== 'undefined') {
                                document.dispatchEvent(new CustomEvent('lr:panelChartsReady'));
                            } else {
                                var chartCheck = setInterval(function() {
                                    if (typeof Chart !== 'undefined') {
                                        clearInterval(chartCheck);
                                        document.dispatchEvent(new CustomEvent('lr:panelChartsReady'));
                                    }
                                }, 50);
                                setTimeout(function() { clearInterval(chartCheck); }, 5000);
                            }

                            panel.dataset.tabLoaded = 'true';
                            panel.dispatchEvent(new CustomEvent('lr:tabLoaded', { bubbles: true }));
                        })
                        .catch(function(err) {
                            console.error('Tab load failed:', err);
                            panel.innerHTML = '<div class="lr-tab-error">' + errorMsg + '</div>';
                        })
                        .finally(function() {
                            delete panel.dataset.tabLoading;
                        });
                }

                function activateFromHash() {
                    var hash = (window.location.hash || '').replace(/^#/, '');
                    if (!hash) return;
                    var panel = document.getElementById(hash);
                    if (panel && panel.classList.contains('lr-tab-lazy')) {
                        loadTab(panel);
                    }
                }

                document.addEventListener('DOMContentLoaded', function() {
                    // Listen for tab clicks (Craft's tab UI shows the panel via hash navigation
                    // which fires hashchange; we also bind clicks for reliability)
                    document.querySelectorAll('a[href^="#analytics"], a[href^="#responses"]').forEach(function(link) {
                        link.addEventListener('click', function() {
                            var targetId = link.getAttribute('href').replace(/^#/, '');
                            var panel = document.getElementById(targetId);
                            if (panel && panel.classList.contains('lr-tab-lazy')) {
                                loadTab(panel);
                            }
                        });
                    });

                    // If page loads with #analytics or #responses, fire immediately
                    activateFromHash();
                });

                // Browser-driven hash navigation (back/forward)
                window.addEventListener('hashchange', activateFromHash);
            })();
        </script>
    {% endif %}
{% endblock %}

{% block details %}
    <div class="meta">
        {# Enabled #}
        {{ forms.lightswitchField({
            label: 'Enabled'|t('campaign-manager'),
            id: 'enabled',
            name: 'enabled',
            on: campaign.getEnabledForSite(),
        }) }}

        {% set canManageRecipients = currentUser.can('campaignManager:manageRecipients') %}
        {% set canAddRecipients = currentUser.can('campaignManager:addRecipients') %}
        {% set canImportRecipients = currentUser.can('campaignManager:importRecipients') %}
        {% if campaign.id and (canManageRecipients or canAddRecipients or canImportRecipients) %}
            <div class="field" style="margin-top: 15px;">
                <div class="heading">
                    <label>{{ 'Actions'|t('campaign-manager') }}</label>
                </div>
                <div class="input">
                    <div class="btngroup" style="width: 100%;">
                        <button type="button" class="btn menubtn" data-icon="settings" style="width: 100%;">{{ 'Campaign Actions'|t('campaign-manager') }}</button>
                        <div class="menu">
                            <ul>
                                {% if currentUser.can('campaignManager:manageRecipients') %}
                                    <li><a href="{{ cpUrl('campaign-manager/campaigns/' ~ campaign.id ~ '/recipients?site=' ~ currentSite.handle) }}">{{ 'View Recipients'|t('campaign-manager') }}</a></li>
                                {% endif %}
                                {% if campaign.getEnabledForSite() %}
                                    {% if currentUser.can('campaignManager:addRecipients') %}
                                        <li><a href="{{ cpUrl('campaign-manager/campaigns/' ~ campaign.id ~ '/add-recipient?site=' ~ currentSite.handle) }}">{{ 'Add Recipient'|t('campaign-manager') }}</a></li>
                                    {% endif %}
                                    {% if currentUser.can('campaignManager:importRecipients') %}
                                        <li><a href="{{ cpUrl('campaign-manager/campaigns/' ~ campaign.id ~ '/import-recipients?site=' ~ currentSite.handle) }}">{{ 'Import Recipients'|t('campaign-manager') }}</a></li>
                                    {% endif %}
                                {% endif %}
                                {% if currentUser.can('campaignManager:runCampaigns') %}
                                    <li><hr class="padded"></li>
                                    <li><a href="#" class="run-campaign-action" data-campaign-id="{{ campaign.id }}" data-site-id="{{ currentSite.id }}">{{ 'Run Campaign'|t('campaign-manager') }}</a></li>
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    {% if campaign.id %}
        <div class="meta read-only">
            <div class="data">
                <h5 class="heading">{{ 'Recipients'|t('campaign-manager') }}</h5>
                <div class="value">
                    {% if currentUser.can('campaignManager:manageRecipients') %}
                        <a href="{{ cpUrl('campaign-manager/campaigns/' ~ campaign.id ~ '/recipients?site=' ~ currentSite.handle) }}">
                            {{ campaign.recipientCount }}
                        </a>
                    {% else %}
                        {{ campaign.recipientCount }}
                    {% endif %}
                </div>
            </div>
            <div class="data">
                <h5 class="heading">{{ 'Sent'|t('campaign-manager') }}</h5>
                <div class="value">{{ campaign.sentCount }}</div>
            </div>
            <div class="data">
                <h5 class="heading">{{ 'Pending'|t('campaign-manager') }}</h5>
                <div class="value">{{ campaign.pendingCount }}</div>
            </div>
            <div class="data">
                <h5 class="heading">{{ 'Created at'|t('campaign-manager') }}</h5>
                <div class="value">{{ campaign.dateCreated|lrDatetime }}</div>
            </div>
            <div class="data">
                <h5 class="heading">{{ 'Updated at'|t('campaign-manager') }}</h5>
                <div class="value">{{ campaign.dateUpdated|lrDatetime }}</div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% js %}
    // Set platform-specific keyboard shortcut
    const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
    const saveShortcut = document.getElementById('save-shortcut');
    if (saveShortcut) {
        saveShortcut.textContent = isMac ? '⌘S' : 'Ctrl+S';
    }

    // Run Campaign action
    document.querySelectorAll('.run-campaign-action').forEach(function(link) {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            var campaignId = this.dataset.campaignId;
            var siteId = this.dataset.siteId;

            Craft.sendActionRequest('POST', 'campaign-manager/campaigns/run-all', {
                data: { campaignId: campaignId, siteId: siteId }
            }).then(function(response) {
                if (response.data.success) {
                    var queueUrl = {{ cpUrl('utilities/queue-manager')|json_encode|raw }};
                    var queueMsg = {{ 'Campaign job queued. Check the queue for progress.'|t('campaign-manager')|json_encode|raw }};
                    Craft.cp.displayNotice(queueMsg, {
                        details: $('<a/>', {href: queueUrl, text: Craft.t('app', 'View')}),
                    });
                }
            }).catch(function(error) {
                Craft.cp.displayError({{ 'Failed to run campaign'|t('campaign-manager')|json_encode|raw }});
            });
        });
    });
{% endjs %}
