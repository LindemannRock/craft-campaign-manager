{#
 # Campaign Manager - Default Invitation Template
 #
 # This is a minimal fallback template. Copy it to your project's templates
 # folder and customize it, then set the `invitationTemplate` setting to
 # point to your custom template.
 #
 # The invitation URL uses a `?code=` query parameter.
 #}

<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'Invitation'|t('campaign-manager') }}</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
            text-align: center;
        }
        .error { color: #c00; }
        .success { color: #090; }
    </style>
</head>
<body>
    {% set invitationCode = craft.app.request.getQueryParam('code') ?? null %}

    {% if invitationCode is null %}
        <h1>{{ 'Invalid Invitation'|t('campaign-manager') }}</h1>
        <p class="error">{{ 'Invalid or missing invitation code.'|t('campaign-manager') }}</p>
    {% else %}
        {% set recipient = craft.campaignManager.recipients.getRecipientByInvitationCode(invitationCode) %}

        {% if not recipient %}
            <h1>{{ 'Invalid Invitation'|t('campaign-manager') }}</h1>
            <p class="error">{{ 'This invitation link is not valid or has expired.'|t('campaign-manager') }}</p>
        {% else %}
            {% set campaign = recipient.getCampaign() %}

            {% if not campaign %}
                <h1>{{ 'Invalid Invitation'|t('campaign-manager') }}</h1>
                <p class="error">{{ 'The campaign for this invitation could not be found.'|t('campaign-manager') }}</p>
            {% elseif recipient.hasSubmission() %}
                <h1>{{ campaign.title ?? 'Invitation'|t('campaign-manager') }}</h1>
                <p class="error">{{ 'You have already responded to this invitation.'|t('campaign-manager') }}</p>
            {% elseif recipient.invitationIsExpired() %}
                <h1>{{ campaign.title ?? 'Invitation'|t('campaign-manager') }}</h1>
                <p class="error">{{ 'This invitation has expired.'|t('campaign-manager') }}</p>
            {% else %}
                {% do craft.campaignManager.recipients.markAsOpened(recipient) %}
                <h1>{{ campaign.title ?? 'Invitation'|t('campaign-manager') }}</h1>
                <p class="success">{{ 'Welcome! Please complete the form below.'|t('campaign-manager') }}</p>

                {% set form = campaign.getForm() %}
                {% if form %}
                    {{ craft.formie.renderForm(form) }}
                {% endif %}
            {% endif %}
        {% endif %}
    {% endif %}
</body>
</html>
