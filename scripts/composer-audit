#!/usr/bin/env bash
#
# Composer security audit for Campaign Manager. Real advisories fail; abandoned
# packages are only reported. Without a package lock (the shared workspace
# layout) the package manifest is resolved into an owned temporary lock first.

set -euo pipefail

PACKAGE_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$PACKAGE_ROOT"

if [ "${CAMPAIGN_MANAGER_COMPOSER_AUDIT_FORCE_TEMP:-}" != "1" ] \
    && { [ -f composer.lock ] || [ -f vendor/composer/installed.json ]; }; then
    exec composer audit --abandoned=report
fi

AUDIT_TMP_ROOT="${TMPDIR:-/tmp}"
AUDIT_WORKTREE="$(mktemp -d "$AUDIT_TMP_ROOT/campaign-manager-composer-audit.XXXXXX")"

cleanup_audit_worktree() {
    case "$AUDIT_WORKTREE" in
        "$AUDIT_TMP_ROOT"/campaign-manager-composer-audit.*)
            rm -rf -- "$AUDIT_WORKTREE"
            ;;
        *)
            echo "Refusing to remove unexpected Composer audit path: $AUDIT_WORKTREE" >&2
            return 1
            ;;
    esac
}
trap cleanup_audit_worktree EXIT

cp composer.json "$AUDIT_WORKTREE/composer.json"
composer update --no-install --no-scripts --no-interaction --prefer-dist --working-dir="$AUDIT_WORKTREE"

if [ "${CAMPAIGN_MANAGER_COMPOSER_AUDIT_FAIL_STAGE:-}" = "after-update" ]; then
    echo "Injected Composer audit failure after temporary lock creation." >&2
    exit 79
fi

composer audit --abandoned=report --locked --working-dir="$AUDIT_WORKTREE"
