#!/usr/bin/env bash
#
# PHPUnit constituent of the quality gate.
#
# Inside the workspace the suite runs against the DDEV Craft project, followed
# by the disposable-runner lifecycle probe (exact cleanup on failure, shutdown,
# and interruption). A standalone clone runs the whole suite inside one
# disposable Craft project owned by tests/Fixtures/Project/run.php.

set -euo pipefail

PACKAGE_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
WORKSPACE_ROOT="$(CDPATH= cd -- "$PACKAGE_ROOT/../.." 2>/dev/null && pwd -P)"

cd "$PACKAGE_ROOT"
if [ "$PACKAGE_ROOT" = "$WORKSPACE_ROOT/plugins/campaign-manager" ] \
    && [ -f "$WORKSPACE_ROOT/bootstrap.php" ] \
    && [ -f "$WORKSPACE_ROOT/vendor/autoload.php" ]; then
    composer test
    export CAMPAIGN_MANAGER_FIXTURE_SOURCE_VENDOR_ROOT="$WORKSPACE_ROOT/vendor"
    exec php tests/Fixtures/Project/run.php --lifecycle-probe
fi

if [ ! -f "$PACKAGE_ROOT/vendor/autoload.php" ]; then
    echo "Standalone PHPUnit requires package dependencies. Run composer install first." >&2
    exit 2
fi

export CAMPAIGN_MANAGER_FIXTURE_SOURCE_VENDOR_ROOT="$PACKAGE_ROOT/vendor"
php tests/Fixtures/Project/run.php
exec php tests/Fixtures/Project/run.php --lifecycle-probe
