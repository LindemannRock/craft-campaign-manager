#!/usr/bin/env bash
#
# CI contract: the quality-gates job must delegate to `composer quality-gate`
# exactly once, trust exactly "$GITHUB_WORKSPACE" when containerized, and never
# duplicate individual constituents.

set -euo pipefail

WORKFLOW="${1:-.github/workflows/ci.yml}"
if [ ! -f "$WORKFLOW" ]; then
    echo "CI workflow not found: $WORKFLOW" >&2
    exit 1
fi

canonical_count="$(grep -Ec '^[[:space:]]*(-[[:space:]]+)?run:[[:space:]]+composer quality-gate[[:space:]]*$' "$WORKFLOW" || true)"
if [ "$canonical_count" -ne 1 ]; then
    echo "The CI quality-gates job must invoke 'composer quality-gate' exactly once." >&2
    exit 1
fi

if grep -Eq 'safe[.]directory[^[:cntrl:]]*[*]' "$WORKFLOW"; then
    echo "The CI quality-gates job must never use wildcard safe.directory trust." >&2
    exit 1
fi

container_count="$(awk '
    /^  quality-gates:[[:space:]]*$/ { in_job = 1; next }
    in_job && /^  [A-Za-z0-9_-]+:[[:space:]]*$/ { in_job = 0 }
    in_job && /^    container:/ { count++ }
    END { print count + 0 }
' "$WORKFLOW")"
safe_count="$(grep -Ec 'safe[.]directory' "$WORKFLOW" || true)"
exact_trust_count="$(grep -Ec '^[[:space:]]*(-[[:space:]]+)?run:[[:space:]]+git config --global --add safe[.]directory "[$]GITHUB_WORKSPACE"[[:space:]]*$' "$WORKFLOW" || true)"

if [ "$container_count" -gt 0 ]; then
    if [ "$container_count" -ne 1 ] || [ "$safe_count" -ne 1 ] || [ "$exact_trust_count" -ne 1 ]; then
        echo 'A containerized quality-gates job must trust exactly "$GITHUB_WORKSPACE" once.' >&2
        exit 1
    fi

    checkout_line="$(grep -nE '^[[:space:]]*-[[:space:]]+uses:[[:space:]]+actions/checkout@v6[[:space:]]*$' "$WORKFLOW" | head -n 1 | cut -d: -f1)"
    trust_line="$(grep -nE '^[[:space:]]*(-[[:space:]]+)?run:[[:space:]]+git config --global --add safe[.]directory "[$]GITHUB_WORKSPACE"[[:space:]]*$' "$WORKFLOW" | head -n 1 | cut -d: -f1)"
    gate_line="$(grep -nE '^[[:space:]]*(-[[:space:]]+)?run:[[:space:]]+composer quality-gate[[:space:]]*$' "$WORKFLOW" | head -n 1 | cut -d: -f1)"
    if [ -z "$checkout_line" ] || [ -z "$trust_line" ] || [ -z "$gate_line" ] \
        || [ "$trust_line" -le "$checkout_line" ] || [ "$trust_line" -ge "$gate_line" ]; then
        echo 'The exact "$GITHUB_WORKSPACE" trust must run after checkout and before composer quality-gate.' >&2
        exit 1
    fi
elif [ "$safe_count" -ne 0 ]; then
    echo "A non-containerized quality-gates job must not add safe.directory trust for Act." >&2
    exit 1
fi

install_count="$(grep -Ec 'uses:[[:space:]]+ramsey/composer-install@v4[[:space:]]*$' "$WORKFLOW" || true)"
if [ "$install_count" -ne 1 ]; then
    echo "The CI quality-gates job must use ramsey/composer-install@v4 exactly once." >&2
    exit 1
fi

if grep -Eq '^[[:space:]]*(-[[:space:]]+)?run:[[:space:]]+composer (audit|phpstan|check-cs|test|ci|ci:full)([[:space:]]|$)' "$WORKFLOW"; then
    echo "CI must delegate package verification to composer quality-gate without partial duplicate constituents." >&2
    exit 1
fi

echo "CI workflow contract passed."
